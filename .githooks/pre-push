#!/usr/bin/env bash
# pre-push: push されるコミットに含まれる秘密情報を secretlint (Docker公式イメージ) で検査する
set -euo pipefail

SECRETLINT_IMAGE="secretlint/secretlint:v13.0.4"

echo "pre-push: secretlint による秘密情報検査を開始します..." >&2

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-push: docker が見つかりません。検査できないため push を中止します。" >&2
  exit 1
fi

# --- 準備 ----------------------------------------------------------------
remote_name="${1:-origin}"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
empty_tree=$(git hash-object -t tree /dev/null)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

found=0

# --- push 対象の抽出 -----------------------------------------------------
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue          # ブランチ削除

  if [ "$remote_oid" = "$zero" ]; then
    # 新規ブランチ: 既に他のリモート追跡ブランチにあるコミットは除外する
    oldest=$(git rev-list "$local_oid" --not --remotes="$remote_name" 2>/dev/null | tail -1 || true)
    [ -z "$oldest" ] && continue
    if git rev-parse -q --verify "${oldest}^" >/dev/null 2>&1; then
      base="${oldest}^"
    else
      base="$empty_tree"                          # ルートコミット
    fi
  else
    base="$remote_oid"
  fi

  # 複数 ref を同時に push した際にパスが衝突しないよう ref ごとに分ける
  slug=$(printf '%s' "${local_ref#refs/heads/}" | tr '/' '_')
  dest="$tmp/$slug"

  # NUL 区切りで受けてスペースや改行を含むパスに対応する
  while IFS= read -r -d '' f; do
    mkdir -p "$dest/$(dirname "$f")"
    # 作業ツリーではなく「push される版」の内容を取り出す
    if git show "$local_oid:$f" > "$dest/$f" 2>/dev/null; then
      found=1
    else
      rm -f "$dest/$f"
    fi
  done < <(git diff --name-only --diff-filter=ACMR -z "$base" "$local_oid")
done

if [ "$found" -eq 0 ]; then
  echo "pre-push: 検査対象のファイルがないためスキップします。" >&2
  exit 0
fi

# --- 検査 ------------------------------------------------------------------
# secretlint/secretlint イメージは preset-recommend 等をビルトインしており、
# 設定ファイル無しで動く設計 (https://github.com/secretlint/secretlint)
if ! docker run --rm \
  --mount type=bind,source="$tmp",target="$tmp" \
  --workdir "$tmp" \
  "$SECRETLINT_IMAGE" secretlint '**/*'; then
  cat >&2 <<'EOF'

pre-push: 秘密情報の可能性がある内容を検出したため push を中止しました。
検出箇所の先頭はブランチ名のディレクトリです。実際のパスはその下の部分に対応します。
EOF
  exit 1
fi

echo "pre-push: secretlint 検査OK。push を続行します。" >&2
