#!/usr/bin/env bash
# pre-push: push されるコミットに含まれる秘密情報を secretlint で検査する
set -euo pipefail

SECRETLINTRC="$HOME/vault/dotfiles/.secretlintrc.json"
SECRETLINT_VERSION="13.0.4"

# --- mise / pnpm / node の解決 --------------------------------------------
# git hook は非対話シェルとして起動されるため .zshrc / .zprofile の
# `mise activate` が効かず、GUI の git クライアントから呼ばれる場合を含め
# PATH が最小限になる。mise 経由のフルパスを明示的に解決する
if command -v mise >/dev/null 2>&1; then
  MISE=$(command -v mise)
elif [ -x "$HOME/.local/bin/mise" ]; then
  MISE="$HOME/.local/bin/mise"
else
  MISE=""
fi

PNPM=""
if command -v pnpm >/dev/null 2>&1; then
  PNPM=$(command -v pnpm)
elif [ -n "$MISE" ]; then
  PNPM=$("$MISE" which pnpm 2>/dev/null || true)
fi
if [ -z "$PNPM" ]; then
  echo "pre-push: pnpm が見つかりません。検査できないため push を中止します。" >&2
  exit 1
fi

# pnpm dlx が起動する secretlint 本体は素の node ランタイムを要求するため、
# PATH 上に node が無ければ mise 管理下の node のディレクトリを足す
if ! command -v node >/dev/null 2>&1; then
  if [ -n "$MISE" ] && node_bin=$("$MISE" which node 2>/dev/null); then
    PATH="$(dirname "$node_bin"):$PATH"
    export PATH
  else
    echo "pre-push: node が見つかりません。検査できないため push を中止します。" >&2
    exit 1
  fi
fi

run_secretlint() {
  "$PNPM" dlx \
    -p "secretlint@${SECRETLINT_VERSION}" \
    -p "@secretlint/secretlint-rule-preset-recommend@${SECRETLINT_VERSION}" \
    secretlint "$@"
}

# --- 準備 ----------------------------------------------------------------
remote_name="${1:-origin}"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
empty_tree=$(git hash-object -t tree /dev/null)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

found=0

# --- push 対象の抽出 -----------------------------------------------------
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue          # ブランチ削除

  if [ "$remote_oid" = "$zero" ]; then
    # 新規ブランチ: 既に他のリモート追跡ブランチにあるコミットは除外する
    oldest=$(git rev-list "$local_oid" --not --remotes="$remote_name" 2>/dev/null | tail -1 || true)
    [ -z "$oldest" ] && continue
    if git rev-parse -q --verify "${oldest}^" >/dev/null 2>&1; then
      base="${oldest}^"
    else
      base="$empty_tree"                          # ルートコミット
    fi
  else
    base="$remote_oid"
  fi

  # 複数 ref を同時に push した際にパスが衝突しないよう ref ごとに分ける
  slug=$(printf '%s' "${local_ref#refs/heads/}" | tr '/' '_')
  dest="$tmp/$slug"

  # NUL 区切りで受けてスペースや改行を含むパスに対応する
  while IFS= read -r -d '' f; do
    mkdir -p "$dest/$(dirname "$f")"
    # 作業ツリーではなく「push される版」の内容を取り出す
    if git show "$local_oid:$f" > "$dest/$f" 2>/dev/null; then
      found=1
    else
      rm -f "$dest/$f"
    fi
  done < <(git diff --name-only --diff-filter=ACMR -z "$base" "$local_oid")
done

[ "$found" -eq 0 ] && exit 0

# --- 検査 ----------------------------------------------------------------
if [ ! -f "$SECRETLINTRC" ]; then
  echo "pre-push: $SECRETLINTRC が見つかりません。" >&2
  exit 1
fi
cp "$SECRETLINTRC" "$tmp/.secretlintrc.json"

cd "$tmp"
if ! run_secretlint --secretlintrc "$tmp/.secretlintrc.json" "$tmp/**/*"; then
  cat >&2 <<'EOF'

pre-push: 秘密情報の可能性がある内容を検出したため push を中止しました。
検出箇所の先頭はブランチ名のディレクトリです。実際のパスはその下の部分に対応します。
誤検出の場合は .secretlintrc.json の allowMessageIds かインラインコメントで抑制してください。
EOF
  exit 1
fi
