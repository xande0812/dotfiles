#!/usr/bin/env bash
# pre-push: push されるコミットに含まれる秘密情報を secretlint (Docker公式イメージ) で検査する
set -euo pipefail

SECRETLINT_IMAGE="secretlint/secretlint:v13.0.4"
# イメージの /.secretlintrc.json と同じ既定値
DEFAULT_RC='{"rules":[{"id":"@secretlint/secretlint-rule-preset-recommend"}]}'

echo "pre-push: secretlint による秘密情報検査を開始します..." >&2

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-push: docker が見つかりません。検査できないため push を中止します。" >&2
  exit 1
fi

remote_name="${1:-origin}"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# 検査対象は $tmp/scan に隔離する。$tmp 直下の作業ファイルまで検査してしまわないため。
scan="$tmp/scan"
mkdir -p "$scan"

# --- push 対象の ref を1つに絞る -------------------------------------------
# 複数 ref を同時に push すると、どの ref の .secretlintrc.json を適用するかが一意に
# 決まらない。片方の緩い設定がもう片方にも効く事故を避けるため、まとめて検査しない。
# NF: 空行は $2 が空になり削除扱いから漏れるため、行として数えさせない
pushed=$(awk -v zero="$zero" 'NF && $2 != zero { print $2, $4 }')   # ブランチ削除を除く
case $(printf '%s' "$pushed" | grep -c '^') in
  0)
    echo "pre-push: 新しく push される更新がないためスキップします。" >&2
    exit 0
    ;;
  1) ;;
  *)
    echo "pre-push: 複数の ref を同時に push する場合は検査できません。ref ごとに push してください。" >&2
    exit 1
    ;;
esac
read -r oid remote_oid <<<"$pushed"

# --- リポジトリの設定の引き継ぎ --------------------------------------------
# 検査対象は作業ツリーではなく複製なので、リポジトリ直下の設定は自動では拾われない。
# push される版から取り出す: 未コミットの緩い設定で検査を回避できないようにするため。
#
# ファイルを渡さず内容を --secretlintrcJSON で渡し、設定が無い場合も既定値を必ず
# 渡す。これで塞げる回避経路が2つある。
#   - secretlint (rc-config-loader) は渡されたファイルを JSON → YAML → JavaScript の
#     順に読もうとする。つまり .secretlintrc.json という名前でも JSON として壊れて
#     いれば中身が JavaScript として require され、フックの中でリポジトリ由来の
#     コードが動く。文字列渡しなら JSON.parse だけが走り、壊れていれば異常終了する
#   - 設定を渡さないと package.json の secretlint フィールドが自動検出される。
#     同じ push に {"secretlint":{"rules":[]}} を含めるだけで全ルールを無効化できる
#
# 受け付けるのは .secretlintrc.json だけ。YAML を JSON 文字列に変換するにはパーサが
# 必要で、フックに依存を増やしたくない。他の名前は黙って無視せず中止する。
for rc in .secretlintrc .secretlintrc.yaml .secretlintrc.yml .secretlintrc.js .secretlintrc.cjs; do
  git cat-file -e "$oid:$rc" 2>/dev/null || continue
  echo "pre-push: $rc は読み込めません。.secretlintrc.json にしてください。" >&2
  exit 1
done

rc_json="$DEFAULT_RC"
if git cat-file -e "$oid:.secretlintrc.json" 2>/dev/null; then
  rc_json=$(git cat-file blob "$oid:.secretlintrc.json")

  # コマンド置換は NUL を保持できない。NUL を含む不正な JSON が、NUL の落ちた
  # 妥当な JSON として通ってしまい、検証したものと push されるものが食い違う。
  if [ "$(git cat-file -s "$oid:.secretlintrc.json")" \
     -ne "$(git cat-file blob "$oid:.secretlintrc.json" | tr -d '\0' | wc -c)" ]; then
    echo "pre-push: .secretlintrc.json に NUL が含まれています。" >&2
    exit 1
  fi

  # コミットされた設定は信頼する。書いた本人は --no-verify も使えるので、意図的に
  # 緩める設定 (allows に /.*/、preset に disabled: true) を止める意味がない。
  # ここで弾くのは、意図せず検査が丸ごと無効になる退化した設定だけ。
  #   - 空文字列を渡すと secretlint は --secretlintrcJSON 自体を無視して設定の
  #     自動探索に落ちるため、同じ push に置いた package.json の secretlint
  #     フィールドが効いてしまう (空ファイルをコミットするだけで回避できる)
  #   - `{"rules":[]}` は正常終了して何も検出しない
  # preset の id が書かれていることだけを確かめる。
  case "$rc_json" in
    *'@secretlint/secretlint-rule-preset-recommend'*) ;;
    *)
      echo "pre-push: .secretlintrc.json には @secretlint/secretlint-rule-preset-recommend を含めてください。" >&2
      exit 1
      ;;
  esac

  echo "pre-push: .secretlintrc.json ($(git rev-parse --short "$oid") の版) を適用します。" >&2
fi

# --- 検査範囲の決定 --------------------------------------------------------
if [ "$remote_oid" != "$zero" ]; then
  base="$remote_oid"
else
  # 新規ブランチ: 既に他のリモート追跡ブランチにあるコミットは除外する。
  # rev-list の失敗を握り潰すと検査対象ゼロと区別できず素通りするため、
  # エラーは set -e に拾わせる (結果が空なのは正常終了)
  oldest=$(git rev-list "$oid" --not --remotes="$remote_name" | tail -1)
  if [ -z "$oldest" ]; then
    echo "pre-push: 新しく push されるコミットがないためスキップします。" >&2
    exit 0
  fi
  base=$(git rev-parse -q --verify "${oldest}^" || git hash-object -t tree /dev/null)
fi

# --- push される版の取り出し -----------------------------------------------
# プロセス置換の中で git が失敗しても while は正常終了してしまい、検査対象ゼロと
# して素通りする。一度ファイルに落として失敗を検出する。
# --raw: 各パスの mode を1回の呼び出しで得る (gitlink の判別に使う)
# --no-renames: R は1レコードに2パスを持ち NUL の対応が崩れるため A+D に分解させる
# T (type change): symlink から秘密入りの通常ファイルへの差し替えを取り逃がさない
changed="$tmp/changed"
git diff --raw --no-renames --diff-filter=ACMT -z "$base" "$oid" > "$changed"

found=0
while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
  # リポジトリ直下の .secretlintrc.json は設定として上で読んでいる。組み込み ignore の
  # 対象なので複製しても検査されない。中身は「信頼する設定」として扱う。
  # .secretlintignore はサポートしないので、下の拒否パターンに落として中止させる
  # (複製から外すだけだと、そのファイル自体に秘密を書いて隠せてしまう)。
  case "$path" in
    .secretlintrc.json) continue ;;
  esac

  # secretlint は下のパスを常に検査対象から外す (module/search.js の
  # DEFAULT_IGNORE_PATTERNS)。--no-glob でも extraIgnorePatterns として適用されるので
  # CLI では外せない。複製しても検査されないまま素通りするので中止する。
  #   **/.git **/node_modules **/.secretlintrc **/.secretlintrc.{json,yaml,yml,js}
  #   **/.secretlintignore*
  # .secretlintrc* は前方一致で弾く。ディレクトリとして prune されるため
  # `nested/.secretlintrc.json/leak.env` のように中に隠せる一方、実際に ignore
  # されない .secretlintrc.cjs や .secretlintrc.backup まで巻き込むが、検査できない
  # ものを通すより安全側に倒す。
  case "/$path" in
    */.git|*/.git/*|*/node_modules|*/node_modules/*|\
    */.secretlintrc*|*/.secretlintignore*)
      echo "pre-push: $path は secretlint が検査できない名前のため push を中止します。" >&2
      exit 1
      ;;
  esac

  # ":<src mode> <dst mode> ..." から dst mode を取る
  dst_mode=${meta#:* }
  dst_mode=${dst_mode%% *}
  # submodule の中身は親リポジトリの push では送られないので検査対象外
  [ "$dst_mode" = 160000 ] && continue

  mkdir -p "$scan/$(dirname "$path")"
  # macOS のファイルシステムは大文字小文字を区別せず Unicode も正規化するため、
  # git 上では別物の 2 パスが一時領域で同じファイルになる。無害な側が秘密の側を
  # 上書きして素通りするので、衝突したら中止する。
  if [ -e "$scan/$path" ]; then
    echo "pre-push: $path が一時領域で別のパスと衝突するため push を中止します。" >&2
    exit 1
  fi
  git cat-file blob "$oid:$path" > "$scan/$path"
  found=1
done < "$changed"

# 設定だけを変更した push は検査対象がゼロになる。secretlint は対象が無いと設定を
# 読む前に異常終了するので、設定が JSON として妥当かを確かめるために無害なファイル
# だけを置いたディレクトリへ向ける。
if [ "$found" -eq 0 ]; then
  echo "pre-push: 検査対象のファイルがないため、設定の検証だけを行います。" >&2
  scan="$tmp/probe"
  mkdir -p "$scan"
  echo ok > "$scan/ok.txt"
fi

# --- 検査 ------------------------------------------------------------------
# --no-gitignore と空の --secretlintignore は、同じ push で秘密ファイルを .gitignore
# や .secretlintignore に足して検査を回避されるのを防ぐ。検査するのは git が push
# すると判断した追跡対象なので、ここで除外を再適用する理由もない。
#
# --network none と readonly は、コミットされた設定を信頼する前提から来る保険。
# 設定の rules[].id はモジュール名でもファイルパスでもよく、リポジトリ内の .mjs を
# 指すと secretlint がそれを import して中身が動く。設定をコミットした時点で検査を
# 骨抜きにできるのは避けられない (allows に /.*/ と書くのと同じ) が、少なくとも
# 通信と書き込みはさせない。
if ! docker run --rm \
  --network none --read-only \
  --mount type=bind,source="$tmp",target="$tmp",readonly \
  --workdir "$scan" \
  "$SECRETLINT_IMAGE" secretlint \
  --no-gitignore --secretlintignore /dev/null \
  --secretlintrcJSON "$rc_json" '**/*'; then
  cat >&2 <<'EOF'

pre-push: 秘密情報の可能性がある内容を検出したため push を中止しました。
検出箇所のパスは一時ディレクトリを基準にしています。リポジトリ内の相対パスに対応します。
EOF
  exit 1
fi

echo "pre-push: secretlint 検査OK。push を続行します。" >&2
