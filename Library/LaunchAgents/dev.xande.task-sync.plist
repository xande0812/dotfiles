<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 30 分ごとに task-sync で取り込み、task-alert で期限を通知する。
       ログインシェル(-l)で起動するのは .zprofile の PATH(brew, ~/.local/bin, mise shims)を使うため。
       launchd は ~ を展開しないので絶対パスを書く。 -->
  <key>Label</key>
  <string>dev.xande.task-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-c</string>
    <string>task-sync &amp;&amp; task-alert</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xande/.local/state/task-sync/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xande/.local/state/task-sync/stderr.log</string>
</dict>
</plist>
